# Пример настроек. Скопируйте в .env и заполните своими значениями.
# Настоящий .env в репозиторий не попадает (см. .gitignore).

# --- Обязательное ---
# Токен бота от @BotFather. Для локальной работы ставьте ПОДСТАВНОЙ:
# с настоящим токеном локальный запуск шлёт сообщения настоящим покупателям.
BOT_TOKEN=000000:LOCAL-DUMMY-NO-SEND

# Владельцы магазина: им видны журнал действий, доступы продавцов и заявки.
SUPER_ADMIN_IDS=

# Управляют товарами и ценами. Продавцы точек заводятся в самом приложении,
# в разделе «Доступ продавцов», — эти переменные нужны только для первого входа.
ADMIN_IDS=

# --- База ---
# Пусто — локальный SQLite (файл shop.db рядом). Заполнено — Postgres.
DATABASE_URL=

# --- Мини-приложение ---
# Адрес, по которому Telegram открывает приложение. Пусто — кнопка не заводится.
WEBAPP_URL=

# --- Время ---
SHOP_TZ_OFFSET=3          # часовой пояс магазина (Минск), от UTC
SUMMARY_HOUR=21           # когда слать владельцу сводку за день
BACKUP_HOUR=4             # когда снимать резервную копию

# --- Вторая копия базы (необязательно) ---
# Любой WebDAV (Яндекс.Диск, Nextcloud) или S3-совместимое хранилище.
# Пароль — приложения, НЕ основной от аккаунта.
BACKUP_URL=
BACKUP_USER=
BACKUP_PASSWORD=

# --- Прочее ---
ROLE=all                  # all (бот и сайт вместе), web или bot
DEV_MODE=0                # 1 подставляет владельца без Telegram; на боевой базе игнорируется
KEEP_WARM=1               # самопинг, чтобы бесплатный тариф не засыпал
ERROR_COOLDOWN=600        # как часто повторять одно и то же сообщение о поломке
PHOTO_CACHE_MB=50         # сколько места отдать кэшу картинок
